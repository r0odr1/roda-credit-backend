# Configuración de la aplicación Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Conexión PostgreSQL (formato: postgresql+psycopg://user:password@host:port/dbname)
DATABASE_URL=postgresql+psycopg://roda_user:roda_pass@localhost:5432/roda_db

# Tasa de interés efectiva anual (EA) - 18% por defecto
ANNUAL_INTEREST_RATE=0.18

# CORS - URLs permitidas separadas por comas
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Puerto del servidor (Render usa $PORT automáticamente)
PORT=5000
